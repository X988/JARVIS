# JARVIS environment. Copy to an untracked env file or a process manager.
# Never commit real hosts, passwords, or private keys.

# Shared execution switch. Default is dry-run for every layer.
# Policy, voice, and Telegram: mock | dry-run | real. Any other value is a config error
# and the server stays in dry-run.
# Tool execution (SSH / MikroTik): only the exact value "live" leaves dry-run.
# "real" and "mock" keep tools in dry-run. Dry-run shows the command and does not connect.
EXECUTION_MODE=dry-run

# --- Tool execution (SSH / MikroTik). Separate from the read-only server probes below.

# Local Ollama for the tool-calling loop. qwen3 is the default model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3
OLLAMA_TIMEOUT_MS=1500

# Append-only tool audit log. Keep this path outside Git.
JARVIS_AUDIT_PATH=data/audit.jsonl
JARVIS_KNOWN_HOSTS=data/ssh/known_hosts

# Optional JSON file outside Git. See secrets/jarvis.example.json.
# JARVIS_SECRETS_FILE=/run/secrets/jarvis.json

# Optional operator list: id:role:name:telegramId
# Roles: admin, operator, viewer. Only admin and operator can approve tool changes.
# JARVIS_OPERATORS=admin1:admin:admin1:100842,operator1:operator:operator1:100900

# SSH for the tool layer. Key auth only. The identity file must be an absolute path outside Git.
# JARVIS_SSH_HOSTS=mail01
# JARVIS_SSH_MAIL01_HOST=10.0.0.5
# JARVIS_SSH_MAIL01_USER=jarvis
# JARVIS_SSH_MAIL01_PORT=22
# JARVIS_SSH_MAIL01_KEY=/run/secrets/jarvis_ed25519

# Extra allow entries are separated by ;; so commands can contain spaces.
# The built-in denylist still wins over anything listed here.
# JARVIS_SSH_ALLOW_READ=uptime;;df -h;;systemctl status *
# JARVIS_SSH_ALLOW_CHANGE=systemctl restart nginx;;systemctl restart postfix
# JARVIS_SSH_DENY=custom-dangerous-token

# MikroTik RouterOS REST used by the tool layer (HTTPS). Password stays in the environment or secrets file.
# JARVIS_MT_HOST=10.0.0.1
# JARVIS_MT_USER=jarvis-mikrotik
# JARVIS_MT_PASSWORD=
# JARVIS_MT_PORT=443
# JARVIS_MT_TLS_INSECURE=false

# --- Policy server, voice, and adapters.

# AI agent. Disabled by default; when enabled it may autonomously execute only risk-0 read-only runbooks.
JARVIS_AI_AGENT_ENABLED=0
# Maximum planner steps per turn (1..8).
JARVIS_AGENT_MAX_STEPS=6
# Shared LLM transport limits.
JARVIS_LLM_TIMEOUT_MS=45000
JARVIS_LLM_MAX_PROMPT_CHARS=24000
JARVIS_LLM_MAX_OUTPUT_TOKENS=2000
JARVIS_LLM_RETRY_ATTEMPTS=2

# Route each workload to an explicit provider: openai | anthropic | gemini | ollama.
# No provider/model is selected implicitly.
# JARVIS_LLM_INTENT_PROVIDER=openai
# JARVIS_LLM_SENSITIVE_PROVIDER=ollama
# JARVIS_LLM_CODING_PROVIDER=
# JARVIS_LLM_RESEARCH_PROVIDER=
# JARVIS_LLM_CRITIC_PROVIDER=
#
# OpenAI Responses API.
# OPENAI_API_KEY=
# JARVIS_OPENAI_MODEL=
# JARVIS_OPENAI_BASE_URL=https://api.openai.com/v1
#
# Anthropic Messages API.
# ANTHROPIC_API_KEY=
# JARVIS_ANTHROPIC_MODEL=
# JARVIS_ANTHROPIC_BASE_URL=https://api.anthropic.com
# JARVIS_ANTHROPIC_VERSION=2023-06-01
#
# Gemini GenerateContent API.
# GEMINI_API_KEY=
# JARVIS_GEMINI_MODEL=
# JARVIS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#
# Local Ollama for the policy LLM gateway. Keep sensitive infrastructure result synthesis local when possible.
# These names are separate from OLLAMA_BASE_URL / OLLAMA_MODEL used by the tool loop.
# JARVIS_OLLAMA_URL=http://127.0.0.1:11434
# JARVIS_OLLAMA_MODEL=
# JARVIS_LLM_LOCAL=1

# State directory for audit, approvals, idempotency and file locks.
# JARVIS_STATE_DIR=./data
# JARVIS_LOCK_DIR=
# file | redis. Redis without a live client fails closed.
JARVIS_LOCK_BACKEND=file
# JARVIS_REDIS_URL=

# Local email/password (no Grok/Google/X broker). See README, section
# "Локальный вход на LAN". Registration does not grant operator rights.
#
# Public browser origin, including https and the port. No path.
# BETTER_AUTH_URL=https://192.168.0.184:9443
# Extra origins, comma-separated (hostname and IP, for example).
# BETTER_AUTH_TRUSTED_ORIGINS=https://jarvis.lan:9443
# Stable session secret. openssl rand -hex 32
# BETTER_AUTH_SECRET=
# 0 / false closes sign-up after the first admin. Sign-in stays open.
# JARVIS_EMAIL_SIGNUP=1
# Persist accounts when DATABASE_URL is unset. In-memory PGLite dies on restart.
# JARVIS_PGLITE_DIR=./data/pglite
# Vite allows IP hosts. Set this for a DNS name, or * for any hostname.
# JARVIS_ALLOWED_HOSTS=jarvis.lan
# Optional absolute asset origin for `npm run dev` behind the proxy.
# JARVIS_DEV_ORIGIN=https://192.168.0.184:9443
# Must not be "false", or Better Auth sessions are ignored.
# VITE_AUTH_ENABLED=true

# Web actors: {"<better-auth-user-id>":{"actorId":"admin1","role":"operator"}}
# The id is shown on the ACTOR_DENIED screen and by `npm run users:web`.
# JARVIS_WEB_ACTORS_JSON=
# Telegram: {"<telegram-id>":{"actorId":"admin1","role":"operator"}}
# JARVIS_TELEGRAM_ACTORS_JSON=
# JARVIS_TELEGRAM_WEBHOOK_SECRET=
# JARVIS_TELEGRAM_TOKEN=

# Test-only header x-jarvis-test-actor. Ignored when NODE_ENV=production.
# JARVIS_TEST_AUTH=0

# Read-only Windows/WinRM. Prefer target maps so every inventory id resolves explicitly.
# JARVIS_POWERSHELL_ENABLED=0
# JARVIS_WINDOWS_TARGETS_JSON={"dc01":"dc01.example","srv1c01":"srv1c01.example","sql01":"sql01.example","fs01":"fs01.example"}
# Legacy single-target fallback for dc01 only:
# JARVIS_WINDOWS_HOST=
# JARVIS_WINDOWS_USER=DOMAIN\jarvis-read
# JARVIS_WINDOWS_PASSWORD=
# JARVIS_WINDOWS_USE_SSL=1
# JARVIS_WINDOWS_PORT=5986
# JARVIS_WINDOWS_TIMEOUT_MS=30000
# JARVIS_PWSH_BIN=pwsh

# Read-only Linux/SSH probes. StrictHostKeyChecking stays enabled.
# These names are separate from JARVIS_SSH_HOSTS / JARVIS_SSH_<ALIAS>_* used by the tool layer.
# Read-only Linux/SSH. StrictHostKeyChecking=yes and UpdateHostKeys=no.
# production, EXECUTION_MODE=real and JARVIS_PROFILE=production-infra refuse to
# connect unless JARVIS_SSH_KNOWN_HOSTS_FILE and JARVIS_SSH_KEY_FILE are set.
# Unknown host keys are never auto-trusted.
# JARVIS_SSH_ENABLED=0
# JARVIS_SSH_TARGETS_JSON={"mail01":"mail01.example"}
# Legacy single-target fallback for mail01 only:
# JARVIS_SSH_HOST=
# JARVIS_SSH_USER=jarvis-read
# JARVIS_SSH_PORT=22
# JARVIS_SSH_KEY_FILE=/run/secrets/jarvis_ssh
# JARVIS_SSH_KNOWN_HOSTS_FILE=/etc/ssh/ssh_known_hosts
# JARVIS_SSH_TIMEOUT_MS=15000
# JARVIS_SSH_BIN=ssh

# SQL Server.
# JARVIS_SQL_HOST=
# JARVIS_SQL_PORT=1433
# JARVIS_SQL_USER=
# JARVIS_SQL_PASSWORD=
# JARVIS_SQL_BACKUP_DIR=
# JARVIS_SQL_CONNECT_TIMEOUT_MS=5000
# JARVIS_SQL_HEALTH_TIMEOUT_MS=15000
# JARVIS_SQL_BACKUP_TIMEOUT_MS=3600000
# JARVIS_SQL_ENCRYPT=1
# JARVIS_SQL_TRUST_CERT=0

# RouterOS 7 REST API for read-only probes, HTTPS only. For an internal CA use NODE_EXTRA_CA_CERTS.
# These names are separate from JARVIS_MT_* used by the tool layer.
# RouterOS 7 REST API, HTTPS only. For an internal CA use NODE_EXTRA_CA_CERTS.
# JARVIS_MIKROTIK_TLS_INSECURE and NODE_TLS_REJECT_UNAUTHORIZED=0 are refused.
# Change calls stay disabled unless JARVIS_MIKROTIK_CHANGE_ENABLED=1, and even
# then this block does not open a mutating RouterOS connection.
# JARVIS_ROUTEROS_ENABLED=0
# JARVIS_MIKROTIK_HOST=
# JARVIS_MIKROTIK_PORT=443
# JARVIS_MIKROTIK_USER=jarvis-read
# JARVIS_MIKROTIK_PASSWORD=
# JARVIS_ROUTEROS_TIMEOUT_MS=10000
# Mailcow read-only probe over SSH.
# JARVIS_DOCKER_ENABLED=0
# JARVIS_DOCKER_HOST=mail01.example
# JARVIS_DOCKER_USER=jarvis-read
# JARVIS_DOCKER_SSH_PORT=22
# JARVIS_DOCKER_SSH_KEY_FILE=/run/secrets/mailcow_key
# JARVIS_DOCKER_KNOWN_HOSTS_FILE=/etc/ssh/ssh_known_hosts
# JARVIS_DOCKER_TIMEOUT_MS=20000
# JARVIS_MAILCOW_COMPOSE=/opt/mailcow-dockerized/docker-compose.yml

# 1C source dump. development/test only. Production deployment stays DENY_ALWAYS.
# JARVIS_ONEC_DUMP=
# External 1C validators are fixed wrapper executables, never arbitrary shell strings.
# BSL wrapper receives the changed module file path.
# JARVIS_BSL_LS_CHECK_BIN=/opt/jarvis/bin/check-bsl
# Designer/EDT wrapper receives the export root.
# JARVIS_1CV8_DESIGNER_CHECK_BIN=/opt/jarvis/bin/check-designer
# JARVIS_EDT_CHECK_BIN=/opt/jarvis/bin/check-edt
# Test DB wrapper receives the export root and must return 0 only after verification.
# JARVIS_ONEC_TEST_DB_CHECK_BIN=/opt/jarvis/bin/check-test-db
# JARVIS_ONEC_VALIDATION_TIMEOUT_MS=120000
# Bounded read-only traversal of exported 1C sources.
# JARVIS_ONEC_SEARCH_MAX_FILES=10000
# JARVIS_ONEC_SEARCH_MAX_DEPTH=32
# JARVIS_ONEC_SEARCH_MAX_FILE_BYTES=2097152

# Browser workbench. Read-only HTTP(S) is denied unless hostname is explicitly allowlisted.
# JARVIS_BROWSER_ALLOW_HOSTS=github.com,docs.example.com
# JARVIS_BROWSER_MAX_BYTES=2097152

# Monitoring. Unset providers show MONITORING_NOT_CONFIGURED, not demo numbers.
# JARVIS_PROMETHEUS_URL=
# JARVIS_ZABBIX_URL=
# JARVIS_ZABBIX_TOKEN=
# JARVIS_ALERTMANAGER_URL=
# JARVIS_MONITOR_TIMEOUT_MS=10000

# Voice. STT/TTS models stay outside git.
# JARVIS_STT_PROVIDER=faster-whisper
# JARVIS_STT_MODEL=small
# JARVIS_STT_LANGUAGE=ru
# JARVIS_STT_DEVICE=auto
# JARVIS_MODEL_DIR=./models
# JARVIS_PYTHON_BIN=python3
# JARVIS_STT_TIMEOUT_MS=90000
# Optional whisper.cpp-compatible wrapper. It receives one jailed WAV path and returns JSON.
# JARVIS_WHISPER_CPP_WRAPPER=/opt/jarvis/bin/whisper-wrapper
# JARVIS_WHISPER_CPP_TIMEOUT_MS=90000
# JARVIS_STT_MAX_MS=30000
# JARVIS_STT_MIN_CONFIDENCE=0.55
# Confident detection of another language is rejected instead of guessed as a command.
# JARVIS_STT_LANGUAGE_MIN_CONFIDENCE=0.55
# JARVIS_STT_BEAM_SIZE=5
# JARVIS_STT_VAD_SILENCE_MS=500
# JARVIS_STT_VAD_PAD_MS=200
# JARVIS_STT_NO_SPEECH_THRESHOLD=0.65
# JARVIS_STT_PROMPT=Джарвис. UTP. Mailcow. MikroTik. WireGuard. SQL. 1С.
# JARVIS_ENDPOINT_SILENCE_MS=800
# JARVIS_WAKE_WORD_ENABLED=0
#
# Local Russian TTS via Piper. Point to a local .onnx voice model.
# JARVIS_TTS_PROVIDER=piper
# JARVIS_TTS_BIN=piper
# JARVIS_TTS_MODEL=/opt/jarvis/models/ru_RU-voice.onnx
# JARVIS_TTS_TIMEOUT_MS=30000
# JARVIS_TTS_MAX_CHARS=360
# Piper: lower length scale is faster speech; 1.0 is neutral.
# JARVIS_TTS_LENGTH_SCALE=1.0
# Pause between sentences in seconds.
# JARVIS_TTS_SENTENCE_SILENCE=0.18
# JARVIS_PROFILE=demo

# External audit anchor. The local hash chain cannot detect whole-file replacement.
# HTTP/Loki use a durable outbox with bounded retry. Syslog remains ADAPTER_DISABLED
# until a dedicated real transport is implemented.
# JARVIS_AUDIT_SYSLOG=
# JARVIS_AUDIT_HTTP_URL=
# JARVIS_AUDIT_LOKI_URL=
# JARVIS_AUDIT_TIMEOUT_MS=5000
# JARVIS_AUDIT_RETRY_ATTEMPTS=3
# JARVIS_AUDIT_RETRY_BASE_MS=250
# JARVIS_AUDIT_MAX_BACKLOG=10000

# Local state lock behavior. Live owner PIDs are never evicted by age alone.
# JARVIS_STATE_LOCK_TIMEOUT_MS=10000
# JARVIS_STATE_LOCK_STALE_MS=30000

# Bounded filesystem state / retention. Security evidence is also preserved in
# append-only audit; cleanup never treats missing/corrupt state as success.
# JARVIS_RATE_LIMIT_RETENTION_MS=86400000
# JARVIS_RATE_LIMIT_MAX_BUCKETS=10000
# JARVIS_IDEMPOTENCY_RETENTION_MS=2592000000
# Legacy pending records without owner PID only:
# JARVIS_IDEMPOTENCY_LEGACY_PENDING_STALE_MS=30000
# Duplicate callers wait this long for a live owner, then fail without re-executing.
# JARVIS_IDEMPOTENCY_WAIT_MS=10000
# JARVIS_IDEMPOTENCY_MAX_RECORDS=50000
# JARVIS_APPROVAL_RETENTION_MS=2592000000
# JARVIS_APPROVAL_MAX_RECORDS=20000
# JARVIS_JOB_RETENTION_MS=2592000000
# JARVIS_JOB_MAX_RECORDS=10000
# JARVIS_EXECUTION_HISTORY_MAX=10000
# JARVIS_WORKTREE_RETENTION_MS=604800000
# JARVIS_TELEGRAM_INBOUND_RETENTION_MS=86400000
# JARVIS_TELEGRAM_INBOUND_MAX_FILES=2000
# JARVIS_ADAPTER_PROBE_TTL_MS=120000

# Read-only GitHub token for github.ci adapter; grant Actions/metadata read only.
JARVIS_GITHUB_TOKEN=
