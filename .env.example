# Сервер JARVIS. Пароли боевых машин сюда не класть и в git не коммитить.
EXECUTION_MODE=dry-run
JARVIS_ALLOW_DEV_LOGIN=1
JARVIS_SESSION_SECRET=change-me
# JARVIS_ADMIN_PASSWORD= только если NODE_ENV=production и dev-вход выключен
# JARVIS_STATE_DIR=./data
# JARVIS_SSH_HOST=
# JARVIS_WINDOWS_HOST=
# JARVIS_SQL_HOST=
# JARVIS_MIKROTIK_HOST=
# JARVIS_DOCKER_HOST=
# JARVIS_ONEC_DUMP=
# JARVIS_AUDIT_HTTP=
# JARVIS_REDIS_URL=
# JARVIS_ZABBIX_URL=
# JARVIS_PROMETHEUS_URL=
