# JARVIS tool execution. Copy to an untracked env file or a process manager.
# Never commit real hosts, passwords, or private keys.

# dry-run (default) shows the exact command and does not connect.
# live sends read-only tools immediately and change tools only after Approve.
EXECUTION_MODE=dry-run

# Local Ollama. qwen3 is the default model for the tool-calling loop.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3
OLLAMA_TIMEOUT_MS=1500

# Append-only audit log. Keep this path outside Git.
JARVIS_AUDIT_PATH=data/audit.jsonl
JARVIS_KNOWN_HOSTS=data/ssh/known_hosts

# Optional JSON file outside Git. See secrets/jarvis.example.json.
# JARVIS_SECRETS_FILE=/run/secrets/jarvis.json

# Optional operator list: id:role:name:telegramId
# Roles: admin, operator, viewer. Only admin and operator can approve.
# JARVIS_OPERATORS=admin1:admin:admin1:100842,operator1:operator:operator1:100900

# SSH. Key auth only. The identity file must be an absolute path outside Git.
# JARVIS_SSH_HOSTS=mail01
# JARVIS_SSH_MAIL01_HOST=10.0.0.5
# JARVIS_SSH_MAIL01_USER=jarvis
# JARVIS_SSH_MAIL01_PORT=22
# JARVIS_SSH_MAIL01_KEY=/run/secrets/jarvis_ed25519

# Extra allow entries are separated by ;; so commands can contain spaces.
# The built-in denylist still wins over anything listed here.
# JARVIS_SSH_ALLOW_READ=uptime;;df -h;;systemctl status *
# JARVIS_SSH_ALLOW_CHANGE=systemctl restart nginx;;systemctl restart postfix
# JARVIS_SSH_DENY=custom-dangerous-token

# MikroTik RouterOS REST (HTTPS). Password stays in the environment or secrets file.
# JARVIS_MT_HOST=10.0.0.1
# JARVIS_MT_USER=jarvis-mikrotik
# JARVIS_MT_PASSWORD=
# JARVIS_MT_PORT=443
# JARVIS_MT_TLS_INSECURE=false
