# Server execution. The browser cannot switch this.
# mock | dry-run | real
EXECUTION_MODE=dry-run

# State directory for audit, approvals, idempotency and file locks.
# JARVIS_STATE_DIR=./data
# JARVIS_LOCK_DIR=
# file | redis. Redis without a live client fails closed.
JARVIS_LOCK_BACKEND=file
# JARVIS_REDIS_URL=

# Web actors: {"<better-auth-user-id>":{"actorId":"admin1","role":"operator"}}
# JARVIS_WEB_ACTORS_JSON=
# Telegram: {"<telegram-id>":{"actorId":"admin1","role":"operator"}}
# JARVIS_TELEGRAM_ACTORS_JSON=
# JARVIS_TELEGRAM_WEBHOOK_SECRET=
# JARVIS_TELEGRAM_TOKEN=

# Test-only header x-jarvis-test-actor. Ignored when NODE_ENV=production.
# JARVIS_TEST_AUTH=0

# Read-only Windows/WinRM. Prefer target maps so every inventory id resolves explicitly.
# JARVIS_POWERSHELL_ENABLED=0
# JARVIS_WINDOWS_TARGETS_JSON={"dc01":"dc01.example","srv1c01":"srv1c01.example","sql01":"sql01.example","fs01":"fs01.example"}
# Legacy single-target fallback for dc01 only:
# JARVIS_WINDOWS_HOST=
# JARVIS_WINDOWS_USER=DOMAIN\jarvis-read
# JARVIS_WINDOWS_PASSWORD=
# JARVIS_WINDOWS_USE_SSL=1
# JARVIS_WINDOWS_PORT=5986
# JARVIS_WINDOWS_TIMEOUT_MS=30000
# JARVIS_PWSH_BIN=pwsh

# Read-only Linux/SSH. StrictHostKeyChecking stays enabled.
# JARVIS_SSH_ENABLED=0
# JARVIS_SSH_TARGETS_JSON={"mail01":"mail01.example"}
# Legacy single-target fallback for mail01 only:
# JARVIS_SSH_HOST=
# JARVIS_SSH_USER=jarvis-read
# JARVIS_SSH_PORT=22
# JARVIS_SSH_KEY_FILE=/run/secrets/jarvis_ssh
# JARVIS_SSH_KNOWN_HOSTS_FILE=/etc/ssh/ssh_known_hosts
# JARVIS_SSH_TIMEOUT_MS=15000
# JARVIS_SSH_BIN=ssh

# SQL Server.
# JARVIS_SQL_HOST=
# JARVIS_SQL_PORT=1433
# JARVIS_SQL_USER=
# JARVIS_SQL_PASSWORD=
# JARVIS_SQL_BACKUP_DIR=
# JARVIS_SQL_CONNECT_TIMEOUT_MS=5000
# JARVIS_SQL_HEALTH_TIMEOUT_MS=15000
# JARVIS_SQL_BACKUP_TIMEOUT_MS=3600000
# JARVIS_SQL_ENCRYPT=1
# JARVIS_SQL_TRUST_CERT=0

# RouterOS 7 REST API, HTTPS only. For an internal CA use NODE_EXTRA_CA_CERTS.
# JARVIS_ROUTEROS_ENABLED=0
# JARVIS_MIKROTIK_HOST=
# JARVIS_MIKROTIK_PORT=443
# JARVIS_MIKROTIK_USER=jarvis-read
# JARVIS_MIKROTIK_PASSWORD=
# JARVIS_ROUTEROS_TIMEOUT_MS=10000
# Mailcow read-only probe over SSH.
# JARVIS_DOCKER_ENABLED=0
# JARVIS_DOCKER_HOST=mail01.example
# JARVIS_DOCKER_USER=jarvis-read
# JARVIS_DOCKER_SSH_PORT=22
# JARVIS_DOCKER_SSH_KEY_FILE=/run/secrets/mailcow_key
# JARVIS_DOCKER_KNOWN_HOSTS_FILE=/etc/ssh/ssh_known_hosts
# JARVIS_DOCKER_TIMEOUT_MS=20000
# JARVIS_MAILCOW_COMPOSE=/opt/mailcow-dockerized/docker-compose.yml

# 1C source dump. development/test only. Production deployment stays DENY_ALWAYS.
# JARVIS_ONEC_DUMP=

# Monitoring. Unset providers show MONITORING_NOT_CONFIGURED, not demo numbers.
# JARVIS_PROMETHEUS_URL=
# JARVIS_ZABBIX_URL=

# Voice. Weights stay outside git, in JARVIS_MODEL_DIR.
# JARVIS_STT_PROVIDER=faster-whisper
# JARVIS_STT_MODEL=small
# JARVIS_STT_LANGUAGE=ru
# JARVIS_STT_DEVICE=auto
# JARVIS_MODEL_DIR=./models
# JARVIS_VAD_AGGRESSIVENESS=2
# JARVIS_ENDPOINT_SILENCE_MS=800
# JARVIS_WAKE_WORD_ENABLED=0
# JARVIS_TTS_PROVIDER=kokoro
# JARVIS_TTS_VOICE=
# JARVIS_TTS_SPEED=1.05
# JARVIS_PROFILE=demo

# External audit anchor. The local hash chain cannot see a replaced file.
# Setting a URL does not deliver events until a client is connected (ADAPTER_DISABLED).
# JARVIS_AUDIT_SYSLOG=
# JARVIS_AUDIT_HTTP_URL=
# JARVIS_AUDIT_LOKI_URL=
