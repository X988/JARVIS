{
  "version": 1,
  "variables": {
    "EXECUTION_MODE": {
      "required": false,
      "default": "dry-run",
      "enum": [
        "mock",
        "dry-run",
        "real"
      ],
      "secret": false
    },
    "JARVIS_WEB_ACTORS_JSON": {
      "required": true,
      "production": true,
      "secret": true,
      "description": "Map Better Auth user id -> {actorId,role}."
    },
    "JARVIS_TELEGRAM_WEBHOOK_SECRET": {
      "required": false,
      "secret": true
    },
    "JARVIS_TELEGRAM_ACTORS_JSON": {
      "required": false,
      "secret": true,
      "description": "Map Telegram numeric id -> {actorId,role}."
    },
    "JARVIS_STATE_DIR": {
      "required": false,
      "default": "./data",
      "secret": false
    },
    "JARVIS_SSH_ENABLED": {
      "required": false,
      "default": "false",
      "secret": false
    },
    "JARVIS_SSH_USER": {
      "required": false,
      "secret": false
    },
    "JARVIS_POWERSHELL_ENABLED": {
      "required": false,
      "default": "false",
      "secret": false
    },
    "JARVIS_POWERSHELL_AUTH_CONFIGURED": {
      "required": false,
      "default": "false",
      "secret": false
    },
    "JARVIS_SQL_ENABLED": {
      "required": false,
      "default": "false",
      "secret": false
    },
    "JARVIS_SQL_INTEGRATED": {
      "required": false,
      "default": "false",
      "secret": false
    },
    "SQLCMDPASSWORD": {
      "required": false,
      "secret": true
    },
    "JARVIS_SQL_BACKUP_DESTINATION": {
      "required": false,
      "secret": false
    },
    "JARVIS_ROUTEROS_ENABLED": {
      "required": false,
      "default": "false",
      "secret": false
    },
    "JARVIS_ROUTEROS_USER": {
      "required": false,
      "secret": false
    },
    "JARVIS_DOCKER_ENABLED": {
      "required": false,
      "default": "false",
      "secret": false
    },
    "JARVIS_MAILCOW_COMPOSE_FILE": {
      "required": false,
      "secret": false
    },
    "JARVIS_PROMETHEUS_URL": {
      "required": false,
      "secret": false
    },
    "JARVIS_ZABBIX_URL": {
      "required": false,
      "secret": false
    },
    "JARVIS_AUDIT_HTTP": {
      "required": false,
      "secret": true
    },
    "JARVIS_REDIS_URL": {
      "required": false,
      "secret": true
    }
  },
  "testOnly": {
    "JARVIS_TEST_AUTH": {
      "productionForbidden": true
    },
    "VITE_JARVIS_TEST_AUTH": {
      "productionForbidden": true
    },
    "JARVIS_ALLOW_ANY_AUTHENTICATED_DEV": {
      "productionForbidden": true
    }
  }
}
