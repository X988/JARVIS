{
  "version": 1,
  "variables": {
    "EXECUTION_MODE": {
      "required": false,
      "default": "dry-run",
      "enum": ["mock", "dry-run", "real"],
      "secret": false
    },
    "JARVIS_WEB_ACTORS_JSON": {
      "required": true,
      "production": true,
      "secret": true,
      "description": "Map Better Auth user id -> {actorId,role}."
    },
    "JARVIS_TELEGRAM_WEBHOOK_SECRET": { "required": false, "secret": true },
    "JARVIS_TELEGRAM_ACTORS_JSON": {
      "required": false,
      "secret": true,
      "description": "Map Telegram numeric id -> {actorId,role}."
    },
    "JARVIS_TELEGRAM_TOKEN": { "required": false, "secret": true },
    "JARVIS_STATE_DIR": { "required": false, "default": "./data", "secret": false },
    "JARVIS_SSH_ENABLED": { "required": false, "default": "false", "secret": false },
    "JARVIS_SSH_HOST": { "required": false, "secret": false },
    "JARVIS_SSH_USER": { "required": false, "secret": false },
    "JARVIS_POWERSHELL_ENABLED": { "required": false, "default": "false", "secret": false },
    "JARVIS_WINDOWS_HOST": { "required": false, "secret": false },
    "JARVIS_WINDOWS_USER": { "required": false, "secret": false },
    "JARVIS_SQL_ENABLED": { "required": false, "default": "false", "secret": false },
    "JARVIS_SQL_HOST": { "required": false, "secret": false },
    "JARVIS_SQL_PORT": { "required": false, "default": "1433", "secret": false },
    "JARVIS_SQL_USER": { "required": false, "secret": false },
    "JARVIS_SQL_PASSWORD": { "required": false, "secret": true },
    "JARVIS_SQL_BACKUP_DIR": { "required": false, "secret": false },
    "JARVIS_SQL_CONNECT_TIMEOUT_MS": { "required": false, "default": "5000", "secret": false },
    "JARVIS_SQL_HEALTH_TIMEOUT_MS": { "required": false, "default": "15000", "secret": false },
    "JARVIS_SQL_BACKUP_TIMEOUT_MS": { "required": false, "default": "3600000", "secret": false },
    "JARVIS_SQL_ENCRYPT": { "required": false, "default": "1", "secret": false },
    "JARVIS_SQL_TRUST_CERT": { "required": false, "default": "0", "secret": false },
    "JARVIS_ROUTEROS_ENABLED": { "required": false, "default": "false", "secret": false },
    "JARVIS_ROUTEROS_USER": { "required": false, "secret": false },
    "JARVIS_DOCKER_ENABLED": { "required": false, "default": "false", "secret": false },
    "JARVIS_MAILCOW_COMPOSE": { "required": false, "secret": false },
    "JARVIS_PROMETHEUS_URL": { "required": false, "secret": false },
    "JARVIS_ZABBIX_URL": { "required": false, "secret": false },
    "JARVIS_AUDIT_HTTP_URL": { "required": false, "secret": true },
    "JARVIS_REDIS_URL": { "required": false, "secret": true }
  },
  "testOnly": {
    "JARVIS_TEST_AUTH": { "productionForbidden": true },
    "VITE_JARVIS_TEST_AUTH": { "productionForbidden": true },
    "JARVIS_ALLOW_ANY_AUTHENTICATED_DEV": { "productionForbidden": true }
  }
}
