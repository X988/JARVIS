// Расширение JarvisDev, префикс jrvs_.
// Контур: development или test.
// Модуль ничего не записывает, не вызывает Выполнить() и не ходит в production.

Функция Контур() Экспорт

	Возврат "test";

КонецФункции

Функция СводкаПравки(ИмяОбъекта, ИмяМодуля) Экспорт

	Если Не ЗначениеЗаполнено(ИмяОбъекта) Тогда
		ВызватьИсключение "Не указан объект метаданных.";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ИмяМодуля) Тогда
		ИмяМодуля = "Модуль";
	КонецЕсли;

	Возврат "Контур test. Расширение JarvisDev. Объект " + ИмяОбъекта
		+ ". Модуль " + ИмяМодуля
		+ ". Основная конфигурация и production не изменяются.";

КонецФункции

Функция ИменаСобственныхОбъектов() Экспорт

	Имена = Новый Массив;
	Имена.Добавить("jrvs_РазработчикТест");
	Имена.Добавить("jrvs_Разработка");
	Возврат Имена;

КонецФункции
